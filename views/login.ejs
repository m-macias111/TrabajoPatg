<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Kilómetro 0 | Iniciar Sesión</title>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <div class="auth-container">
        <div class="logo">
            <i class="fa-solid fa-leaf" style="color:var(--primary);"></i>
            <span style="font-family:'Outfit'; font-weight:800; color:var(--primary);">Kilómetro 0</span>
        </div>
        <h2 style="margin-bottom: 0.5rem;">¡Estábamos esperándote!</h2>
        <p style="color: var(--text-light); margin-bottom: 2rem;">Inicia sesión para continuar</p>
        
        <form id="loginForm" onsubmit="handleLogin(event)">
            <div class="form-group">
                <label>Correo Electrónico</label>
                <input type="email" id="email" required placeholder="tu@email.com">
            </div>
            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" id="password" required placeholder="••••••••">
            </div>
            
            <button class="btn btn-primary" type="submit" style="width: 100%; margin-top: 1rem;">Entrar</button>
            <p id="loginError" style="color:red; margin-top:1rem; font-weight:600; display:none;"></p>
        </form>

        <p style="margin-top:1rem; font-size:0.9rem;">
            <a href="/forgot-password" style="color:var(--text-light);">¿Olvidaste tu contraseña?</a>
        </p>

        <p style="margin-top: 1rem; color: var(--text-light);">
            ¿No tienes cuenta? <a href="/register" style="color: var(--primary); font-weight: bold;">Regístrate</a>
        </p>
        <p style="margin-top: 1rem;">
            <a href="/" style="font-size:0.9rem; color:gray;"><i class="fa-solid fa-arrow-left"></i> Volver a inicio</a>
        </p>
    </div>

    <script>
        // Procesa el inicio de sesión: envía las credenciales y, si son válidas,
        // guarda la sesión y redirige al panel correspondiente según el rol.
        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;

            const errEl = document.getElementById('loginError');
            errEl.style.display = 'none';

            fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            })
            .then(r => r.json())
            .then(data => {
                if(!data.success) {
                    errEl.innerText = data.message;
                    errEl.style.display = 'block';
                    return;
                }
                localStorage.setItem('km0_user', JSON.stringify(data.user));
                if(data.user.role === 'admin') window.location.href = '/admin-app';
                else if(data.user.role === 'producer') window.location.href = '/producer-app';
                else window.location.href = '/client-app';
            })
            .catch(err => {
                errEl.innerText = 'Error de conexión con el servidor: ' + err.message;
                errEl.style.display = 'block';
            });
        }
    </script>
    <%- include('partials/footer') %>
</body>
</html>
